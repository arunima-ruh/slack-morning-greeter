{
  "name": "slack-morning-greeter",
  "version": "1.0.0",
  "description": "Daily morning greeting sent via Slack DM at 10:00 AM UTC",
  "agent_metadata": {
    "agent_name": "Slack Morning Greeter",
    "agent_id": "slack-morning-greeter",
    "avatar": "☀️",
    "tone": "Friendly and warm",
    "domain": "Team Communication & Productivity",
    "primary_users": "Team members receiving daily greetings",
    "automation_type": "notification",
    "schedule_description": "Daily at 10:00 AM UTC",
    "cron_expression": "0 10 * * *"
  },
  "skills": [
    "data-writer",
    "greeting-sender",
    "result-query"
  ],
  "workflows": {
    "main": "workflows/main.yaml"
  },
  "cron": {
    "morning-greeting": "cron/morning-greeting.json"
  },
  "env": {
    "required": [
      "SLACK_BOT_TOKEN",
      "SLACK_USER_ID"
    ],
    "optional": [
      "PG_CONNECTION_STRING",
      "ORG_ID",
      "AGENT_ID"
    ]
  }
}
